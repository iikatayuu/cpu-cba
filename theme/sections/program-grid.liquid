{%- assign col = section.settings.collection | default: collections['programs'] -%}
<section class="section{% if section.settings.style == 'paper' %} section--paper{% endif %}" id="programs-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="section-head section-head--row">
      <div>
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p class="lede">{{ section.settings.text }}</p>{%- endif -%}
      </div>
      {%- if section.settings.show_filters -%}
        <div class="filter-chips" data-filter-group="programs-{{ section.id }}" role="group" aria-label="Filter programs">
          <button type="button" class="chip" data-filter="all" aria-pressed="true">All programs</button>
          <button type="button" class="chip" data-filter="BSBA" aria-pressed="false">BSBA majors</button>
          <button type="button" class="chip" data-filter="BS" aria-pressed="false">BS degrees</button>
        </div>
      {%- endif -%}
    </div>
    {%- if col.products.size > 0 -%}
      <div class="grid grid--3">
        {%- for product in col.products limit: section.settings.limit -%}
          <div class="reveal" data-filter-item="{{ product.metafields.cba.degree_type.value | default: 'BS' }}">{% render 'program-card', product: product %}</div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="empty"><h3>Programs coming soon</h3><p>Add products to the “programs” collection (or run the seed script) to show them here.</p></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Program grid",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Defaults to the 'programs' collection." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our programs" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find the business degree that fits you" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "show_filters", "label": "Show BSBA / BS filters", "default": true },
    { "type": "range", "id": "limit", "label": "Max programs", "min": 3, "max": 12, "step": 1, "default": 6 },
    { "type": "select", "id": "style", "label": "Background", "default": "cream", "options": [ { "value": "cream", "label": "Cream" }, { "value": "paper", "label": "White" } ] }
  ],
  "presets": [{ "name": "Program grid" }]
}
{% endschema %}
