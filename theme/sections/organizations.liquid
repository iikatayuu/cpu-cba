<section class="section section--cream" {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="section-head">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="lede">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="grid grid--3">
      {%- for block in section.blocks -%}
        <div class="org reveal" {{ block.shopify_attributes }}><span class="org__abbr">{{ block.settings.abbr }}</span><p>{{ block.settings.name }}</p></div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Student organizations",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Student life" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your organization" },
    { "type": "textarea", "id": "text", "label": "Intro" }
  ],
  "blocks": [ { "type": "org", "name": "Organization", "settings": [
    { "type": "text", "id": "abbr", "label": "Abbreviation" },
    { "type": "text", "id": "name", "label": "Full name" }
  ] } ],
  "presets": [{ "name": "Student organizations" }]
}
{% endschema %}
