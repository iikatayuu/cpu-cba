<section class="hero" {{ section.shopify_attributes }}>
  <span class="hero__deco" aria-hidden="true"></span>
  <div class="page-width hero__grid">
    <div class="reveal">
      <div class="hero__badges">
        {%- for block in section.blocks -%}<span class="badge" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>{%- endfor -%}
      </div>
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h1>{{ section.settings.heading }}</h1>
      <p class="lede">{{ section.settings.text }}</p>
      <div class="button-row" style="margin-top: var(--space-6)">
        {%- if section.settings.button_1 != blank -%}<a class="button button--primary" href="{{ section.settings.link_1 | default: '/collections/programs' }}">{{ section.settings.button_1 }}</a>{%- endif -%}
        {%- if section.settings.button_2 != blank -%}<a class="button button--outline" href="{{ section.settings.link_2 | default: '/pages/about' }}">{{ section.settings.button_2 }}</a>{%- endif -%}
      </div>
    </div>
    <div class="hero__media reveal">
      {% render 'placeholder-media', image: section.settings.image, asset: section.settings.image_asset, label: section.settings.image_label, ratio: '4 / 5', sizes: '(min-width: 960px) 45vw, 100vw' %}
      <div class="hero__ribbon">
        <div><strong>{{ section.settings.ribbon_title }}</strong><span>{{ section.settings.ribbon_text }}</span></div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "College of Business and Accountancy" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Shape the business of <em>tomorrow</em>, grounded in faith." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Six programs in business, finance, marketing, people management, entrepreneurship and management accounting, taught at a CHED Center of Excellence in Iloilo City." },
    { "type": "text", "id": "button_1", "label": "Primary button", "default": "Explore programs" },
    { "type": "url", "id": "link_1", "label": "Primary link" },
    { "type": "text", "id": "button_2", "label": "Secondary button", "default": "Why CBA?" },
    { "type": "url", "id": "link_2", "label": "Secondary link" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_asset", "label": "Theme asset fallback", "default": "cba-campus.jpg", "info": "Used until an image is selected above." },
    { "type": "text", "id": "image_label", "label": "Placeholder caption", "default": "CBA students in front of Valentine Hall, CPU campus, Jaro" },
    { "type": "text", "id": "ribbon_title", "label": "Ribbon title", "default": "Since 1935" },
    { "type": "text", "id": "ribbon_text", "label": "Ribbon text", "default": "90 years of business education" }
  ],
  "blocks": [ { "type": "badge", "name": "Badge", "limit": 4, "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Level IV Accredited" } ] } ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
