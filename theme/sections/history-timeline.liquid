<section class="section section--paper" {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="section-head section-head--center">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="lede">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <ol class="timeline">
      {%- for block in section.blocks -%}
        <li class="timeline__item reveal" {{ block.shopify_attributes }}>
          <div class="timeline__year">{{ block.settings.year }}</div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "History timeline",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From the College of Commerce to CBA" },
    { "type": "textarea", "id": "text", "label": "Intro" }
  ],
  "blocks": [ { "type": "milestone", "name": "Milestone", "settings": [
    { "type": "text", "id": "year", "label": "Year" },
    { "type": "text", "id": "title", "label": "Title" },
    { "type": "textarea", "id": "text", "label": "Text" }
  ] } ],
  "presets": [{ "name": "History timeline" }]
}
{% endschema %}
