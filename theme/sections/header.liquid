{%- assign menu = linklists[section.settings.menu] -%}
{%- assign max_visible = section.settings.max_visible | default: 5 -%}
{%- assign more_label = section.settings.more_label | default: 'More' -%}
{%- assign more_items = '' -%}
{%- assign more_current = false -%}

<header class="site-header" data-header>
  <div class="page-width site-header__inner">
    {% render 'brand' %}
    <nav class="nav" aria-label="Main">
      <ul class="nav__list">
        {%- if menu.links.size > 0 -%}

          {%- capture more_items -%}
            {%- for link in menu.links -%}
              {%- if forloop.index > max_visible -%}
                <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a></li>
                {%- for child in link.links -%}
                  <li class="nav__sub-child"><a href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title }}</a></li>
                {%- endfor -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endcapture -%}

          {%- for link in menu.links -%}
            {%- if forloop.index <= max_visible -%}
              <li class="nav__item">
                <a class="nav__link" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
                {%- if link.links.size > 0 -%}
                  <ul class="nav__sub">
                    {%- for child in link.links -%}<li><a href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title }}</a></li>{%- endfor -%}
                  </ul>
                {%- endif -%}
              </li>
            {%- else -%}
              {%- if link.current or link.child_current -%}{%- assign more_current = true -%}{%- endif -%}
            {%- endif -%}
          {%- endfor -%}

        {%- else -%}

          {%- assign fb_titles = 'Programs|About|Stories|Reviews|News &amp; Events|FAQs' | split: '|' -%}
          {%- assign fb_urls = routes.collections_url | append: '/programs|' | append: routes.root_url | append: 'pages/about|' | append: routes.root_url | append: 'blogs/stories|' | append: routes.root_url | append: 'pages/reviews|' | append: routes.root_url | append: 'pages/advertisements|' | append: routes.root_url | append: 'pages/faqs' | split: '|' -%}

          {%- capture more_items -%}
            {%- for title in fb_titles -%}
              {%- if forloop.index > max_visible -%}
                <li><a href="{{ fb_urls[forloop.index0] }}">{{ title }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          {%- endcapture -%}

          {%- for title in fb_titles -%}
            {%- if forloop.index <= max_visible -%}
              <li class="nav__item"><a class="nav__link" href="{{ fb_urls[forloop.index0] }}">{{ title }}</a></li>
            {%- endif -%}
          {%- endfor -%}

        {%- endif -%}

        {%- if more_items != blank -%}
          <li class="nav__item nav__item--more" data-more>
            <button type="button" class="nav__link nav__more-btn" aria-haspopup="true" aria-expanded="false" aria-controls="NavMore"{% if more_current %} aria-current="page"{% endif %} data-more-toggle>{{ more_label }}</button>
            <ul class="nav__sub" id="NavMore">
              {{ more_items }}
            </ul>
          </li>
        {%- endif -%}
      </ul>
    </nav>
    <div class="header-actions">
      <button type="button" class="icon-button" data-open="search" aria-expanded="false" aria-controls="SearchModal" aria-label="Search">{% render 'icon', name: 'search' %}</button>
      {%- if section.settings.cta_label != blank -%}
        <a class="button button--primary button--small header-cta" href="{{ section.settings.cta_link | default: '/pages/contact' }}">{{ section.settings.cta_label }}</a>
      {%- endif -%}
      <button type="button" class="icon-button menu-toggle" data-open="drawer" aria-expanded="false" aria-controls="MenuDrawer" aria-label="Open menu">{% render 'icon', name: 'menu' %}</button>
      {%- if section.settings.show_cart -%}
        <a class="icon-button header-cart" href="{{ routes.cart_url }}" aria-label="Cart, {{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %}">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M2.5 3h2.7l2.4 11.2a1.6 1.6 0 0 0 1.6 1.3h8.6a1.6 1.6 0 0 0 1.6-1.2L21 7H6.2"/></svg>
          <span class="header-cart__count{% if cart.item_count == 0 %} is-empty{% endif %}" data-cart-count>{{ cart.item_count }}</span>
        </a>
      {%- endif -%}
    </div>
  </div>
</header>

<div class="drawer" id="MenuDrawer" data-modal="drawer" aria-hidden="true">
  <div class="drawer__overlay" data-close></div>
  <div class="drawer__panel on-dark" role="dialog" aria-modal="true" aria-label="Menu">
    <button type="button" class="icon-button" data-close aria-label="Close menu">{% render 'icon', name: 'close' %}</button>
    <ul class="drawer__list">
      {%- for link in menu.links -%}
        <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {%- for child in link.links -%}<li class="drawer__sub"><a href="{{ child.url }}">{{ child.title }}</a></li>{%- endfor -%}
      {%- else -%}
        <li><a href="{{ routes.collections_url }}/programs">Programs</a></li>
        <li><a href="{{ routes.root_url }}pages/about">About</a></li>
        <li><a href="{{ routes.root_url }}blogs/stories">Stories</a></li>
        <li><a href="{{ routes.root_url }}pages/reviews">Reviews</a></li>
        <li><a href="{{ routes.root_url }}pages/advertisements">News &amp; Events</a></li>
        <li><a href="{{ routes.root_url }}pages/faqs">FAQs</a></li>
        <li><a href="{{ routes.root_url }}pages/contact">Contact</a></li>
      {%- endfor -%}
    </ul>
    {%- if section.settings.cta_label != blank -%}
      <a class="button button--gold" href="{{ section.settings.cta_link | default: '/pages/contact' }}">{{ section.settings.cta_label }}</a>
    {%- endif -%}
  </div>
</div>

<div class="search-modal" id="SearchModal" data-modal="search" data-predictive-url="{{ routes.predictive_search_url }}.json" aria-hidden="true">
  <div class="search-modal__box" role="dialog" aria-modal="true" aria-label="Search">
    <form class="search-form" action="{{ routes.search_url }}" method="get" role="search">
      {% render 'icon', name: 'search' %}
      <label class="visually-hidden" for="HeaderSearch">Search programs, stories and pages</label>
      <input id="HeaderSearch" type="search" name="q" placeholder="Search programs, stories, FAQs…" autocomplete="off">
      <input type="hidden" name="options[prefix]" value="last">
      <button type="button" class="icon-button" data-close aria-label="Close search">{% render 'icon', name: 'close' %}</button>
    </form>
    <div class="predictive" data-predictive aria-live="polite"></div>
  </div>
</div>

{% stylesheet %}
  .nav__more-btn { border: 0; background: transparent; font: inherit; font-weight: 500; font-size: 0.95rem; cursor: pointer; display: inline-flex; align-items: center; gap: 0.4rem; }
  .nav__more-btn::after { content: ''; width: 6px; height: 6px; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: translateY(-2px) rotate(45deg); transition: transform 0.2s var(--ease); }
  .nav__item--more.is-open > .nav__more-btn::after { transform: translateY(1px) rotate(225deg); }
  .nav__item--more > .nav__sub { left: auto; right: 0; }
  .nav__item--more.is-open > .nav__sub { opacity: 1; visibility: visible; transform: none; }
  .nav__sub a[aria-current='page'] { color: var(--navy-900); font-weight: 600; background: var(--cream-100); }
  .nav__sub .nav__sub-child a { padding-left: 1.6rem; font-size: 0.88rem; color: var(--slate); }

  .header-cart { position: relative; display: inline-flex; align-items: center; justify-content: center; text-decoration: none; color: inherit; }
  .header-cart__count { position: absolute; top: -2px; right: -4px; min-width: 18px; height: 18px; padding: 0 5px; border-radius: 999px; background: var(--gold-500); color: var(--navy-900); font-size: 0.7rem; font-weight: 700; line-height: 18px; text-align: center; }
  .header-cart__count.is-empty { display: none; }
{% endstylesheet %}

<script>
  (function () {
    var more = document.querySelector('[data-more]');
    if (!more) return;
    var btn = more.querySelector('[data-more-toggle]');
    function setOpen(open) {
      more.classList.toggle('is-open', open);
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    }
    btn.addEventListener('click', function () {
      setOpen(!more.classList.contains('is-open'));
    });
    document.addEventListener('click', function (e) {
      if (!more.contains(e.target)) setOpen(false);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') { setOpen(false); }
    });
  })();
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    {
      "type": "range",
      "id": "max_visible",
      "label": "Links shown before \"More\"",
      "info": "Any extra menu links move into the More dropdown.",
      "min": 3,
      "max": 8,
      "step": 1,
      "default": 5
    },
    { "type": "text", "id": "more_label", "label": "More button label", "default": "More" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Inquire now" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "checkbox", "id": "show_cart", "label": "Show cart icon", "default": true }
  ]
}
{% endschema %}
