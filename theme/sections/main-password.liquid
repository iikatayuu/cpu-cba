<section class="splash splash--page" style="min-height: 100svh">
  <div class="splash__bg" aria-hidden="true"></div>
  <div class="splash__content on-dark">
    <img class="splash__seal" src="{{ 'cba-logo-transparent.png' | asset_url }}" width="360" height="168" alt="College of Business and Accountancy logo">
    <p class="splash__kicker">Central Philippine University</p>
    <h1 class="splash__title">{{ section.settings.heading }}</h1>
    <p class="splash__motto">{{ shop.password_message | default: section.settings.text }}</p>
    {%- form 'storefront_password', class: 'big-search' -%}
      {%- if form.errors -%}<p class="form-status form-status--error" role="alert">Incorrect password. Please try again.</p>{%- endif -%}
      <label class="visually-hidden" for="Password">Password</label>
      <input id="Password" type="password" name="password" autocomplete="current-password" placeholder="Enter password">
      <button class="button button--gold" type="submit">Enter</button>
    {%- endform -%}
  </div>
</section>
{% schema %}
{
  "name": "Password",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon" },
    { "type": "text", "id": "text", "label": "Message", "default": "The new College of Business and Accountancy website is almost ready." }
  ]
}
{% endschema %}
