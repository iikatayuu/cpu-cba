<footer class="site-footer on-dark">
  <div class="page-width">
    <div class="footer-grid">
      <div class="footer-brand">
        {% render 'brand' %}
        <p>{{ section.settings.about }}</p>
        <div class="social">
          {%- if settings.social_facebook != blank -%}<a href="{{ settings.social_facebook }}" aria-label="Facebook">{% render 'icon', name: 'facebook' %}</a>{%- endif -%}
          {%- if settings.social_youtube != blank -%}<a href="{{ settings.social_youtube }}" aria-label="YouTube">{% render 'icon', name: 'youtube' %}</a>{%- endif -%}
          {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a>{%- endif -%}
        </div>
      </div>
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          <h2>{{ block.settings.heading }}</h2>
          <ul class="footer-links">
            {%- for link in block.settings.menu.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}
      <div>
        <h2>Contact</h2>
        <ul class="footer-links">
          <li><a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a></li>
          <li><a href="tel:{{ settings.contact_phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}">{{ settings.contact_phone }}</a></li>
          <li>{{ settings.contact_address }}</li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ settings.college_name }}, Central Philippine University. Scientia et Fides.</span>
      <span><a href="{{ routes.root_url }}pages/policies">Policies</a> · <a href="{{ routes.root_url }}pages/faqs">FAQs</a> · <a href="{{ routes.search_url }}">Search</a></span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "textarea", "id": "about", "label": "About text", "default": "Forming Christian business leaders since 1935. A CHED Center of Excellence in Business Administration, with ACSCU-AAI Level IV accredited programs." }
  ],
  "blocks": [
    { "type": "menu", "name": "Menu column", "limit": 3, "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Explore" },
      { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
    ] }
  ]
}
{% endschema %}
