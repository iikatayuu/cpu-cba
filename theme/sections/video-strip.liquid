<section class="section section--paper" {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="section-head">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="lede">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="video-strip">
      {%- for block in section.blocks -%}
        <figure class="video-tile reveal" {{ block.shopify_attributes }}>
          {%- if block.settings.video != blank or block.settings.video_url != blank -%}
            {% render 'bg-video', video: block.settings.video, url: block.settings.video_url %}
          {%- elsif block.settings.image_asset != blank -%}
            <img src="{{ block.settings.image_asset | asset_url }}" width="1600" height="1200" loading="lazy" alt="{{ block.settings.caption | escape }}">
          {%- else -%}
            {% render 'placeholder-media', label: 'Short muted clip, e.g. CBA intramurals at the CPU Gym', ratio: '4 / 3' %}
          {%- endif -%}
          {%- if block.settings.caption != blank -%}<figcaption>{{ block.settings.caption }}</figcaption>{%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Video strip",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Life at Central" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "More than classrooms" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Intramurals, org events and CBA Week: student life at CPU builds teamwork and leadership." }
  ],
  "blocks": [ { "type": "video", "name": "Video", "limit": 4, "settings": [
    { "type": "video", "id": "video", "label": "Video" },
    { "type": "url", "id": "video_url", "label": "Or video file URL (.mp4)" },
    { "type": "text", "id": "image_asset", "label": "Image fallback asset", "info": "Used until a video is uploaded." },
    { "type": "text", "id": "caption", "label": "Caption" }
  ] } ],
  "presets": [{ "name": "Video strip" }]
}
{% endschema %}
