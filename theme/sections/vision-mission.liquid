<section class="section" {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="section-head section-head--center">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="vm">
      <div class="vm__card vm__card--navy reveal"><h3>Vision</h3><p>{{ section.settings.vision }}</p></div>
      <div class="vm__card reveal"><h3>Mission</h3><p>{{ section.settings.mission }}</p></div>
    </div>
    {%- if section.blocks.size > 0 -%}
      <h3 style="margin-top: var(--space-7); text-align:center">Core values</h3>
      <div class="values">
        {%- for block in section.blocks -%}
          <div class="value reveal" {{ block.shopify_attributes }}><h4>{{ block.settings.name }}</h4><p>{{ block.settings.text }}</p></div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Vision, mission & values",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Central Philippine University" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Exemplary Christian Education for Life" },
    { "type": "textarea", "id": "vision", "label": "Vision" },
    { "type": "textarea", "id": "mission", "label": "Mission" }
  ],
  "blocks": [ { "type": "value", "name": "Core value", "limit": 8, "settings": [
    { "type": "text", "id": "name", "label": "Value" },
    { "type": "textarea", "id": "text", "label": "Description" }
  ] } ],
  "presets": [{ "name": "Vision, mission & values" }]
}
{% endschema %}
