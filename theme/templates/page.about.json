    "history": {
      "type": "history-timeline",
      "blocks": {
        "m_1": {
          "type": "milestone",
          "settings": {
            "year": "1935",
            "title": "The College of Commerce opens",
            "text": "The Board of Trustees opens a junior College of Commerce offering the Certificate for Associate in Commercial Science, with 20 students. Miss Natividad Sitchon is the first dean."
          }
        },
        "m_2": {
          "type": "milestone",
          "settings": {
            "year": "1946",
            "title": "A full college",
            "text": "The junior college becomes a full college, offering majors in Accounting, Business Administration, Economics, and Finance."
          }
        },
        "m_3": {
          "type": "milestone",
          "settings": {
            "year": "1975",
            "title": "New programs",
            "text": "Dr. Milagros Dignadice becomes the second dean. Entrepreneurship, Management, Marketing, BS Accountancy and BS Computer Science are added under her leadership."
          }
        },
        "m_4": {
          "type": "milestone",
          "settings": {
            "year": "1982",
            "title": "First accreditation",
            "text": "The Association of Christian Schools and Colleges Accrediting Agency grants the College of Commerce Level 1 accreditation status."
          }
        },
        "m_5": {
          "type": "milestone",
          "settings": {
            "year": "1987",
            "title": "Entrepreneurship pioneer",
            "text": "The College is chosen as one of five pilot schools in entrepreneurship in the country, and receives Level 2 accreditation."
          }
        },
        "m_6": {
          "type": "milestone",
          "settings": {
            "year": "1997",
            "title": "Level 3",
            "text": "ACSC-AAI grants the Commerce program Level 3 accreditation. Mrs. Perla G. Deocampo becomes the third dean."
          }
        },
        "m_7": {
          "type": "milestone",
          "settings": {
            "year": "2001",
            "title": "Fourth dean",
            "text": "Mrs. Teresita E. Crucero becomes the fourth Dean, serving until 2017."
          }
        },
        "m_8": {
          "type": "milestone",
          "settings": {
            "year": "2006",
            "title": "College of Business and Accountancy",
            "text": "On April 1, 2006 the Board of Trustees renames the College of Commerce the College of Business and Accountancy. The Accounting Refresher Course is integrated into the BS Accountancy curriculum as 24 units of Integrated Review."
          }
        },
        "m_9": {
          "type": "milestone",
          "settings": {
            "year": "2012",
            "title": "Center of Development",
            "text": "CHED designates CPU a Center of Development (COD) in Business Administration."
          }
        },
        "m_10": {
          "type": "milestone",
          "settings": {
            "year": "2016",
            "title": "Center of Excellence",
            "text": "CHED grants CPU Center of Excellence status in Business Administration, later extended."
          }
        },
        "m_11": {
          "type": "milestone",
          "settings": {
            "year": "2017",
            "title": "Level IV",
            "text": "ACSCU-AAI grants Level IV Re-Accreditation to Business Administration and BS Accountancy. Dr. Lorna T. Grande becomes the fifth Dean (Dean since June 1, 2018)."
          }
        },
        "m_12": {
          "type": "milestone",
          "settings": {
            "year": "2018",
            "title": "BS Management Accounting returns",
            "text": "BS Management Accounting is re-offered under the new curriculum, in compliance with CHED Memo No. 28, s. 2017."
          }
        },
        "m_13": {
          "type": "milestone",
          "settings": {
            "year": "2023",
            "title": "Level IV to 2028",
            "text": "On December 11, 2023 both BSBA and BSA are granted Level IV Re-Accreditation, valid until December 2028. A CPU graduate places Top 9 in the October 2023 CPA Licensure Examination."
          }
        }
      },
