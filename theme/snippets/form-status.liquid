{%- comment -%} Params: form, success_message {%- endcomment -%}
{%- if form.posted_successfully? -%}
  <div class="form-status form-status--success" role="status" tabindex="-1" autofocus>{{ success_message | default: 'Thank you! We received your message and will reply within 2–3 working days.' }}</div>
{%- elsif form.errors -%}
  <div class="form-status form-status--error" role="alert" tabindex="-1" autofocus>
    Please check the form:
    <ul>
      {%- for field in form.errors -%}
        <li>{% if field == 'form' %}{{ form.errors.messages[field] }}{% else %}{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}{% endif %}</li>
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}
