{%- comment -%} Seal + college wordmark. Params: tag (default 'a'), size {%- endcomment -%}
<a class="brand" href="{{ routes.root_url }}" aria-label="{{ settings.college_name }} home">
  {%- if settings.logo != blank -%}
    {{ settings.logo | image_url: width: 260 | image_tag: class: 'brand__seal', width: 150, height: 70, alt: '' }}
  {%- else -%}
    <img class="brand__seal" src="{{ 'cba-logo-transparent.png' | asset_url }}" width="150" height="70" alt="">
  {%- endif -%}
  <span class="brand__text">
    <span class="brand__college">{{ settings.college_name }}</span>
    <span class="brand__uni">Central Philippine University</span>
  </span>
</a>
